# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=paste-32-plus-random-chars-here

# --- Local Postgres (Postgres.app default) ---
DATABASE_URL=postgres://postgres@localhost:5432/clother

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clother-files
R2_PUBLIC_URL=

# --- ZeptoMail (SMTP) ---
ZEPTOMAIL_HOST=smtp.zeptomail.com
ZEPTOMAIL_PORT=587
ZEPTOMAIL_USER=
ZEPTOMAIL_PASS=
MAIL_FROM="Dej. by Ayodeji <hello@yourdomain.com>"

# --- Flutterwave (SANDBOX first — test keys only until Phase 0 gate passes) ---
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx-X
FLW_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxxxxxxxxxx
FLW_WEBHOOK_HASH=your-random-webhook-hash
FLW_BASE_URL=https://api.flutterwave.com/v3
